{
  "name": "zxing-wasm-demo",
  "description": "A local barcode studio for reading, generating and inspecting symbols with zxing-wasm.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/zxing-wasm-demo.git"
  },
  "homepage": "https://github.com/Sec-ant/zxing-wasm-demo",
  "bugs": {
    "url": "https://github.com/Sec-ant/zxing-wasm-demo/issues",
    "email": "zezhengwu@proton.me"
  },
  "keywords": [
    "zxing-wasm",
    "zxing-wasm-demo",
    "react",
    "barcode",
    "qrcode"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "dev": "vite",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit",
    "format:prettier": "prettier . --write",
    "format:biome": "biome format . --write",
    "format": "pnpm format:prettier && pnpm format:biome",
    "check:biome": "biome check --write .",
    "check": "pnpm format:prettier && pnpm check:biome",
    "prebuild": "pnpm -s check && pnpm -s type-check",
    "build": "vite build",
    "preview": "vite preview",
    "bump-biome:latest": "pnpm add -DE @biomejs/biome@latest",
    "bump-biome:nightly": "pnpm add -DE @biomejs/biome@nightly",
    "test": "playwright test",
    "sync:zxing": "node scripts/sync-zxing.mjs",
    "samples:generate": "node scripts/generate-samples.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zxing-wasm": "3.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
