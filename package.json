{
  "name": "zxing-wasm-demo",
  "description": "A local barcode studio for reading, generating and inspecting symbols with zxing-wasm.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/zxing-wasm-demo.git"
  },
  "homepage": "https://github.com/Sec-ant/zxing-wasm-demo",
  "bugs": {
    "url": "https://github.com/Sec-ant/zxing-wasm-demo/issues",
    "email": "zezhengwu@proton.me"
  },
  "keywords": [
    "zxing-wasm",
    "zxing-wasm-demo",
    "react",
    "barcode",
    "qrcode"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "dev": "vite",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit",
    "format:prettier": "prettier . --write",
    "format:biome": "biome format . --write",
    "format": "pnpm format:prettier && pnpm format:biome",
    "check:biome": "biome check --write .",
    "check": "pnpm format:prettier && pnpm check:biome",
    "prebuild": "pnpm -s check && pnpm -s type-check",
    "build": "vite build",
    "preview": "vite preview",
    "bump-biome:latest": "pnpm add -DE @biomejs/biome@latest",
    "bump-biome:nightly": "pnpm add -DE @biomejs/biome@nightly",
    "test": "playwright test",
    "sync:zxing": "node scripts/sync-zxing.mjs",
    "samples:generate": "node scripts/generate-samples.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
