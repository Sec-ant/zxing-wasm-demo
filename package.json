{
  "name": "zxing-wasm-demo",
  "description": "A browser workbench for testing zxing-wasm barcode decoding.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/zxing-wasm-demo.git"
  },
  "homepage": "https://github.com/Sec-ant/zxing-wasm-demo",
