{
  "name": "zxing-wasm-demo",
  "description": "A local barcode studio for reading, generating and inspecting symbols with zxing-wasm.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/zxing-wasm-demo.git"
  },
  "homepage": "https://github.com/Sec-ant/zxing-wasm-demo",
  "bugs": {
    "url": "https://github.com/Sec-ant/zxing-wasm-demo/issues",
    "email": "zezhengwu@proton.me"
  },
  "keywords": [
    "zxing-wasm",
    "zxing-wasm-demo",
    "react",
    "barcode",
    "qrcode"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "dev": "vite",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit",
    "format:prettier": "prettier . --write",
    "format:biome": "biome format . --write",
    "format": "pnpm format:prettier && pnpm format:biome",
    "check:biome": "biome check --write .",
    "check": "pnpm format:prettier && pnpm check:biome",
    "prebuild": "pnpm -s check && pnpm -s type-check",
    "build": "vite build",
    "preview": "vite preview",
    "bump-biome:latest": "pnpm add -DE @biomejs/biome@latest",
    "bump-biome:nightly": "pnpm add -DE @biomejs/biome@nightly",
    "test": "playwright test",
    "sync:zxing": "node scripts/sync-zxing.mjs",
    "samples:generate": "node scripts/generate-samples.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
